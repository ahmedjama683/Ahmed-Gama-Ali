# Copy to .env and change every value before going live.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated host names / IPs that may serve the site
DJANGO_ALLOWED_HOSTS=hargeisa.pillarsdo.org,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://hargeisa.pillarsdo.org
# Leave empty for SQLite (development only). Production: PostgreSQL.
DATABASE_URL=postgres://tax:tax-password@db:5432/tax
POSTGRES_DB=tax
POSTGRES_USER=tax
POSTGRES_PASSWORD=tax-password
# Set to True once the site is behind HTTPS
DJANGO_SECURE=False
SITE_ADDRESS=:80

# Branding (see README "Running it for a client")
SYSTEM_NAME=Hargeisa Tax System
CLIENT_NAME=Hargeisa Local Government
OPERATOR_NAME=
RECEIPT_PREFIX=HGA
MAP_CENTER=9.5624,44.0770
